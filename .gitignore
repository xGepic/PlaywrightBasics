# ---------------------------------------------------------------------------
# .NET build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json

# ---------------------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.rsuser

# JetBrains Rider
.idea/
*.sln.iml

# VS Code (keep shareable settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Test results and coverage
# ---------------------------------------------------------------------------
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
# Traces, screenshots and videos produced by test runs
artifacts/
videos/
traces/
screenshots/
playwright-report/
test-results/

# Saved login sessions (StorageStatePath). These contain real cookies and
# tokens, so never commit them.
auth/
*.storageState.json

# Local browser downloads, if PLAYWRIGHT_BROWSERS_PATH points inside the repo
ms-playwright/

# ---------------------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
